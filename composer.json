{
  "name": "tojoo/laravel-unleash",
  "description": "An Unleash client for Laravel",
  "type": "library",
  "require": {
    "guzzlehttp/guzzle": "^7",
    "illuminate/support": "^6|^7|^8|^9|^10.0|^11.0|^12.0",
    "illuminate/http": "^6|^7|^8|^9|^10.0|^11.0|^12.0",
    "unleash/client": "^1.5",
    "symfony/cache": "^5.3|^6.1",
    "psr/cache": "^1.0|^2.0|^3.0",
    "psr/simple-cache": "^1.0|^2.0|^3.0",
    "http-interop/http-factory-guzzle": "^0.1.0",
    "laravel/framework": "12.*",
    "orchestra/testbench": "10.*"
  },
  "require-dev": {
    "pestphp/pest": "^2.0|^3.0",
    "pestphp/pest-plugin-laravel": "^2.0|^3.0",
    "mockery/mockery": "^1.4.4",
    "phpunit/phpunit": "^10.0|^11.0",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.0",
    "nyholm/psr7": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "Tojoo\\Unleash\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tojoo\\Unleash\\Tests\\": "tests/"
    }
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Jonathan Webb",
      "email": "jonwebb247@gmail.com"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "Tojoo\\Unleash\\Providers\\ServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/pest --coverage",
    "test-coverage-html": "vendor/bin/pest --coverage-html coverage"
  }
}
